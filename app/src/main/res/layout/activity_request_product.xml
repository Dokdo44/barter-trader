<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/requestProductMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_surface"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Send Request"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_on_surface"/>

                    <ImageButton
                        android:id="@+id/backButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/md_primary"
                        android:contentDescription="Close"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_outline"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Name"
                    android:textSize="14sp"
                    android:textColor="@color/md_on_surface"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter your name"
                    android:inputType="textPersonName"
                    android:textColor="@color/md_on_surface"
                    android:textColorHint="@color/md_outline"
                    android:background="@drawable/input_border"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Items to offer"
                    android:textSize="14sp"
                    android:textColor="@color/md_on_surface"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select any that apply:"
                    android:textSize="12sp"
                    android:textColor="@color/md_outline"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/checkboxContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Location"
                    android:textSize="14sp"
                    android:textColor="@color/md_on_surface"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/locationInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter your location"
                    android:inputType="text"
                    android:textColor="@color/md_on_surface"
                    android:textColorHint="@color/md_outline"
                    android:background="@drawable/input_border"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:id="@+id/requestSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Request submitted successfully!"
                    android:visibility="gone"
                    android:gravity="center"
                    android:textColor="@color/md_primary"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/requestButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Send Request"
                    android:backgroundTint="@color/md_primary"
                    android:textColor="@color/md_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>