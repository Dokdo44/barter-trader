<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatListItemMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:minHeight="64dp"
    android:background="@drawable/list_item_border"
    android:padding="12dp">
    <TextView
        android:id="@+id/avatarInitialTextView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:textColor="@color/md_on_primary_container"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="?"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/avatarInitialTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/avatarInitialTextView"
        app:layout_constraintBottom_toBottomOf="@id/avatarInitialTextView">
        <TextView
            android:id="@+id/otherPersonNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(Other Person)"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/productNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="(Product Name)"
            android:textColor="@color/md_outline"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>