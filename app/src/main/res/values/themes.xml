<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTextViewStyle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
    <style name="AppEditTextStyle" parent="android:Widget.EditText">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textColorHint">@color/md_outline</item>
    </style>
    <style name="Base.Theme._3130_grp8_app" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="colorSecondaryContainer">@color/md_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_primary_container</item>
        <item name="android:editTextStyle">@style/AppEditTextStyle</item>
    </style>
    <style name="Theme._3130_grp8_app" parent="Base.Theme._3130_grp8_app" />
</resources>